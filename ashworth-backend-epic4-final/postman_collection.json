  "item": [
    {
      "name": "Clubs",
      "item": [
        {
          "name": "List Clubs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clubs"
          }
        },
        {
          "name": "Get Club by Slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clubs/club-one"
          }
        }
      ]
    },
    {
      "name": "Signup Flow",
      "item": [
        {
          "name": "1. Signup Start",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/signup/start",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clubId\": \"{{clubId}}\",\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"9999999999\",\n  \"dob\": \"1995-01-01\",\n  \"address\": \"123 Main St\",\n  \"occupation\": \"Designer\",\n  \"password\": \"SuperSecret123\"\n}"
            }
          }
        },
        {
          "name": "2. Signup Consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/signup/consent",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signupSessionId\": \"{{signupSessionId}}\",\n  \"consentAccepted\": true,\n  \"consentVersion\": \"v1\",\n  \"signedName\": \"Jane Doe\"\n}"
            }
          }
        },
        {
          "name": "3. Signup OTP Send",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/signup/otp/send",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signupSessionId\": \"{{signupSessionId}}\"\n}"
            }
          }
        },
        {
          "name": "4. Signup OTP Verify",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/signup/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signupSessionId\": \"{{signupSessionId}}\",\n  \"otp\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Login / Session",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"SuperSecret123\"\n}"
            }
          }
        },
        {
          "name": "Login with Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/login/google",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"googleIdToken\": \"<google-id-token>\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/forgot-password/otp/send",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password - Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/user/forgot-password/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"AnotherSecret123\"\n}"
            }
          }
        },
        {
          "name": "Check Auth",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/user/check-auth"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/user/logout"
          }
        }
      ]
    },
    {
