PORT=5000
MONGO_URI=mongodb://localhost:27017/ashworth_club

# JWT
JWT_USER_SECRET=change_me_user_secret
JWT_ADMIN_SECRET=change_me_admin_secret
JWT_USER_EXPIRES_IN=24h
JWT_ADMIN_EXPIRES_IN=24h

# Gmail App Password (Nodemailer)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Cashfree (sandbox) - used from Epic 2 onward, present now for config completeness
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# Cloudinary - used from Epic 2 onward, present now for config completeness
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signup/OTP tuning
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=5
SIGNUP_SESSION_TTL_HOURS=24

# Consent
CURRENT_CONSENT_VERSION=v1

# CORS — comma-separated list of allowed frontend origins. Must include BOTH
# the user-facing membership site and the admin panel's origin (and the
# external Membership-Specific website from contract Section 12, if it's a
# separate origin). Example for local dev with both frontends running:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Defaults to "*" (allow any origin) when unset — fine for early local dev,
# NOT fine for anything deployed; set this explicitly before going live.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
